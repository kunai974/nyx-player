{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window (all platforms). No sql: permission: the page reaches its SQLite database only through the guarded nyx_db_* commands (src-tauri/src/secure_db.rs). App commands are granted one by one (allow-<command>, build.rs app manifest): only this window, with the app's own pages, may call them",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "process:default",
    "os:default",
    "core:app:default",
    "core:path:default",
    "nyx-android:default",
    "allow-iptv-fetch",
    "allow-iptv-fetch-public",
    "allow-ingest-catalog",
    "allow-cancel-catalog-ingestion",
    "allow-ingest-m3u",
    "allow-cancel-m3u-ingestion",
    "allow-m3u-file-write",
    "allow-m3u-file-finish",
    "allow-m3u-file-abort",
    "allow-refresh-catalog",
    "allow-abort-catalog-refresh",
    "allow-load-light-catalog",
    "allow-nyx-db-load",
    "allow-nyx-db-execute",
    "allow-nyx-db-select",
    "allow-nyx-db-close",
    "allow-nyx-db-check",
    "allow-nyx-secret-get",
    "allow-nyx-secret-set",
    "allow-nyx-secret-delete",
    "allow-full-reset",
    "allow-delete-source-catalog",
    "allow-copy-catalog-to-source",
    "allow-build-fusion-index",
    "allow-abort-fusion-index",
    "allow-probe-stream-status",
    "allow-nyx-mpv-init",
    "allow-nyx-mpv-command",
    "allow-nyx-mpv-set-margins",
    "allow-nyx-mpv-alive",
    "allow-nyx-mpv-tls-ready",
    "allow-purge-webview-cache",
    "allow-trim-memory",
    "allow-trim-memory-in-player",
    "allow-set-memory-low",
    "allow-set-memory-normal",
    "allow-set-webview-opaque",
    "allow-set-webview-transparent",
    "allow-get-app-setting",
    "allow-set-app-setting",
    "allow-fetch-and-parse-epg",
    "allow-abort-epg-sync",
    "allow-cancel-epg-abort",
    "allow-remap-epg",
    "allow-poster-prepare",
    "allow-poster-cache-clear",
    "allow-nyx-update-check"
  ]
}
