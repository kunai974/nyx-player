# Supabase (Nyx Player)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry — Crash Reporting (optionnel, l'app fonctionne sans)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# TMDB — TESTING ONLY, DEVELOPMENT BUILDS ONLY (ignored in release builds).
# Calls TMDB directly and bypasses the Supabase proxy. Never put a real token in a file you commit.
# VITE_TMDB_TOKEN=your_tmdb_read_access_token
