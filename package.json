{
  "name": "nyxplayer",
  "private": true,
  "version": "0.8.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "verify": "pnpm typecheck && pnpm test:run && pnpm lint && pnpm lint:css && vite build",
    "perf:bundle": "node scripts/perf/bundle-map.mjs",
    "generate:picon-index": "node scripts/generate-picon-index.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@formkit/auto-animate": "^0.9.0",
    "@sentry/react": "^10.75.3",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "~2.11.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.0",
    "react-window": "^1.8.11",
    "tauri-plugin-mpv-api": "^0.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "~2.11.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.12.0",
    "jpeg-js": "0.4.4",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "pngjs": "^7.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-plugin-defensive-css": "^2.9.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.20.1": "^8.20.1"
    }
  }
}
